<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/m41_dark_bg"
    android:orientation="vertical"
    tools:context=".MainActivity">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="96dp"
        android:background="@drawable/bg_header_gradient"
        android:gravity="bottom|center_vertical"
        android:orientation="horizontal"
        android:paddingStart="20dp"
        android:paddingTop="24dp"
        android:paddingEnd="18dp"
        android:paddingBottom="14dp">

        <ImageView
            android:id="@+id/imgToolbarLogo"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:layout_marginEnd="12dp"
            android:contentDescription="@string/app_name"
            android:src="@drawable/ic_nanosmart" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/txtToolbarTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="NanoSmart"
                android:textColor="@android:color/white"
                android:textSize="23sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Protección conectada"
                android:textColor="#EFFFFFFF"
                android:textSize="12sp" />
        </LinearLayout>

        <TextView
            android:id="@+id/txtToolbarStatus"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_status_unknown_chip"
            android:gravity="center"
            android:minWidth="82dp"
            android:paddingStart="12dp"
            android:paddingTop="7dp"
            android:paddingEnd="12dp"
            android:paddingBottom="7dp"
            android:text="ESTADO"
            android:textColor="@android:color/white"
            android:textSize="12sp"
            android:textStyle="bold" />
    </LinearLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:clipToPadding="false"
        android:fillViewport="true"
        android:overScrollMode="never">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="16dp"
            android:paddingTop="16dp"
            android:paddingEnd="16dp"
            android:paddingBottom="22dp">

            <LinearLayout
                android:id="@+id/panelStateCard"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_panel_status_card"
                android:elevation="5dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/txtCircle"
                    android:layout_width="62dp"
                    android:layout_height="62dp"
                    android:background="@drawable/bg_circle_green"
                    android:gravity="center"
                    android:text="D"
                    android:textColor="@android:color/white"
                    android:textSize="24sp"
                    android:textStyle="bold" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="16dp"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/txtNumber"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:ellipsize="end"
                        android:maxLines="1"
                        android:text="Panel"
                        android:textColor="@color/m41_text_primary"
                        android:textSize="19sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/txtStatus"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:background="@drawable/bg_status_disarmed_chip"
                        android:paddingStart="11dp"
                        android:paddingTop="5dp"
                        android:paddingEnd="11dp"
                        android:paddingBottom="5dp"
                        android:text="Alarma desarmada"
                        android:textColor="@android:color/white"
                        android:textSize="12sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/txtLastAction"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="7dp"
                        android:ellipsize="end"
                        android:maxLines="1"
                        android:text="Última acción: sin identificar"
                        android:textColor="@color/m41_text_secondary"
                        android:textSize="12sp" />
                </LinearLayout>
            </LinearLayout>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:text="CONTROL DEL PANEL"
                android:textColor="@color/m41_text_secondary"
                android:textSize="12sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="3dp"
                android:text="El estado se confirma directamente con el equipo"
                android:textColor="@color/m41_text_secondary"
                android:textSize="12sp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:gravity="center"
                android:orientation="horizontal">

                <androidx.appcompat.widget.AppCompatButton
                    android:id="@+id/btnArm"
                    android:layout_width="0dp"
                    android:layout_height="58dp"
                    android:layout_weight="1"
                    android:background="@drawable/bg_button_arm"
                    android:backgroundTint="@null"
                    android:drawableStart="@drawable/ic_arm_lock"
                    android:drawablePadding="8dp"
                    android:gravity="center"
                    android:text="Armar"
                    android:textAllCaps="false"
                    android:textColor="@android:color/white"
                    android:textSize="16sp"
                    android:textStyle="bold" />

                <Space android:layout_width="12dp" android:layout_height="1dp" />

                <androidx.appcompat.widget.AppCompatButton
                    android:id="@+id/btnDisarm"
                    android:layout_width="0dp"
                    android:layout_height="58dp"
                    android:layout_weight="1"
                    android:background="@drawable/bg_button_disarm"
                    android:backgroundTint="@null"
                    android:drawableStart="@drawable/ic_disarm_unlock"
                    android:drawablePadding="8dp"
                    android:gravity="center"
                    android:text="Desarmar"
                    android:textAllCaps="false"
                    android:textColor="@android:color/white"
                    android:textSize="16sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:background="@drawable/bg_section_card"
                android:elevation="3dp"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="EMERGENCIAS"
                    android:textColor="@color/m41_text_primary"
                    android:textSize="15sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="Cada aviso registra quién lo ejecutó y su ubicación disponible"
                    android:textColor="@color/m41_text_secondary"
                    android:textSize="12sp" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"
                    android:orientation="horizontal">

                    <androidx.appcompat.widget.AppCompatButton
                        android:id="@+id/btnMedica"
                        android:layout_width="0dp"
                        android:layout_height="96dp"
                        android:layout_weight="1"
                        android:background="@drawable/bg_button_medica"
                        android:backgroundTint="@null"
                        android:drawableTop="@drawable/ic_medica"
                        android:drawablePadding="7dp"
                        android:gravity="center"
                        android:padding="8dp"
                        android:text="Médica"
                        android:textAllCaps="false"
                        android:textColor="@android:color/white"
                        android:textSize="13sp"
                        android:textStyle="bold" />

                    <Space android:layout_width="8dp" android:layout_height="1dp" />

                    <androidx.appcompat.widget.AppCompatButton
                        android:id="@+id/btnPanico"
                        android:layout_width="0dp"
                        android:layout_height="96dp"
                        android:layout_weight="1"
                        android:background="@drawable/bg_button_panico"
                        android:backgroundTint="@null"
                        android:drawableTop="@drawable/ic_panico_escudo"
                        android:drawablePadding="7dp"
                        android:gravity="center"
                        android:padding="8dp"
                        android:text="Pánico"
                        android:textAllCaps="false"
                        android:textColor="@android:color/white"
                        android:textSize="13sp"
                        android:textStyle="bold" />

                    <Space android:layout_width="8dp" android:layout_height="1dp" />

                    <androidx.appcompat.widget.AppCompatButton
                        android:id="@+id/btnIncendio"
                        android:layout_width="0dp"
                        android:layout_height="96dp"
                        android:layout_weight="1"
                        android:background="@drawable/bg_button_incendio"
                        android:backgroundTint="@null"
                        android:drawableTop="@drawable/ic_incendio_llama"
                        android:drawablePadding="7dp"
                        android:gravity="center"
                        android:padding="8dp"
                        android:text="Incendio"
                        android:textAllCaps="false"
                        android:textColor="@android:color/white"
                        android:textSize="13sp"
                        android:textStyle="bold" />
                </LinearLayout>
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="18dp"
                android:background="@drawable/bg_section_card"
                android:elevation="3dp"
                android:orientation="vertical"
                android:padding="16dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="ACTIVIDAD RECIENTE"
                            android:textColor="@color/m41_text_primary"
                            android:textSize="15sp"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/txtAlertsStatus"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="3dp"
                            android:text="Esperando conexión con el servidor…"
                            android:textColor="@color/m41_text_secondary"
                            android:textSize="12sp" />
                    </LinearLayout>

                    <androidx.appcompat.widget.AppCompatButton
                        android:id="@+id/btnRefreshAlerts"
                        android:layout_width="94dp"
                        android:layout_height="42dp"
                        android:layout_marginStart="8dp"
                        android:background="@drawable/bg_button_secondary"
                        android:backgroundTint="@null"
                        android:text="Actualizar"
                        android:textAllCaps="false"
                        android:textColor="@color/m41_button_text"
                        android:textSize="12sp" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/alertsContainer"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"
                    android:orientation="vertical" />
            </LinearLayout>
        </LinearLayout>
    </ScrollView>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="76dp"
        android:background="@drawable/bg_bottom_bar"
        android:elevation="10dp"
        android:gravity="center"
        android:orientation="horizontal"
        android:paddingStart="16dp"
        android:paddingTop="10dp"
        android:paddingEnd="16dp"
        android:paddingBottom="12dp">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnPanels"
            android:layout_width="0dp"
            android:layout_height="52dp"
            android:layout_weight="1"
            android:elevation="2dp"
            android:gravity="center"
            android:text="Mis paneles"
            android:textAllCaps="false"
            android:textColor="@color/m41_button_text"
            android:textSize="14sp"
            android:textStyle="bold"
            app:icon="@drawable/ic_panels"
            app:iconGravity="textStart"
            app:iconPadding="7dp"
            app:iconSize="22dp"
            app:iconTint="@color/m41_button_text"
            app:backgroundTint="@color/bottom_nav_button_tint"
            app:cornerRadius="16dp"
            app:strokeColor="@color/m41_nav_button_border"
            app:strokeWidth="2dp" />

        <Space android:layout_width="10dp" android:layout_height="1dp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnHistory"
            android:layout_width="0dp"
            android:layout_height="52dp"
            android:layout_weight="1"
            android:elevation="2dp"
            android:gravity="center"
            android:text="Histórico"
            android:textAllCaps="false"
            android:textColor="@color/m41_button_text"
            android:textSize="14sp"
            android:textStyle="bold"
            app:icon="@drawable/ic_history"
            app:iconGravity="textStart"
            app:iconPadding="7dp"
            app:iconSize="22dp"
            app:iconTint="@color/m41_button_text"
            app:backgroundTint="@color/bottom_nav_button_tint"
            app:cornerRadius="16dp"
            app:strokeColor="@color/m41_nav_button_border"
            app:strokeWidth="2dp" />
    </LinearLayout>
</LinearLayout>
