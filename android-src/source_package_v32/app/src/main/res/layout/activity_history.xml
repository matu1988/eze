<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/m41_dark_bg"
    android:orientation="vertical">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="96dp"
        android:background="@drawable/bg_header_gradient"
        android:gravity="bottom|center_vertical"
        android:orientation="horizontal"
        android:paddingStart="12dp"
        android:paddingTop="24dp"
        android:paddingEnd="18dp"
        android:paddingBottom="14dp">

        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/btnHistoryBack"
            android:layout_width="82dp"
            android:layout_height="44dp"
            android:background="@android:color/transparent"
            android:backgroundTint="@null"
            android:text="‹ Volver"
            android:textAllCaps="false"
            android:textColor="@android:color/white"
            android:textSize="15sp" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Histórico"
                android:textColor="@android:color/white"
                android:textSize="24sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/txtHistoryPanel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Últimas alertas del panel"
                android:textColor="#FFF1F1"
                android:textSize="12sp" />
        </LinearLayout>
    </LinearLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="18dp">

            <TextView
                android:id="@+id/txtHistoryStatus"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Consultando histórico…"
                android:textColor="@color/m41_text_secondary"
                android:textSize="14sp" />

            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/btnRefreshHistory"
                android:layout_width="match_parent"
                android:layout_height="46dp"
                android:layout_marginTop="10dp"
                android:layout_marginBottom="14dp"
                android:background="@drawable/bg_button_secondary"
                android:backgroundTint="@null"
                android:text="Actualizar histórico"
                android:textAllCaps="false"
                android:textColor="@color/m41_button_text" />

            <LinearLayout
                android:id="@+id/historyContainer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical" />
        </LinearLayout>
    </ScrollView>
</LinearLayout>
