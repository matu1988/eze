<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/m41_soft_red" />
            <corners android:radius="20dp" />
            <stroke android:width="2dp" android:color="@color/m41_red_light" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/m41_card_bg" />
            <corners android:radius="20dp" />
            <stroke android:width="1dp" android:color="@color/m41_divider" />
        </shape>
    </item>
</selector>
